{
  "name": "docs-site",
  "scripts": {
    "dev": "vike dev",
    "build": "vike build && pnpm exec pagefind --site dist/client",
    "preview": "vike build && pnpm exec pagefind --site dist/client && vike preview",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@functional-examples/devkit": "^0.1.2",
    "@functional-examples/documentation": "^0.1.2",
    "@functional-examples/javascript": "^0.1.2",
    "@functional-examples/test": "^0.1.2",
    "@functional-examples/yaml-manifest": "^0.1.2",
    "functional-examples": "^0.1.2",
    "gray-matter": "^4.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "rehype-typedoc": "^0.2.0",
    "remark-directive": "^3.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.23.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vike": "^0.4.256",
    "vike-plugin-typedoc": "^0.2.0",
    "vike-react": "^0.6.21",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@shikijs/rehype": "^1.29.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "catalog:",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.4.0",
    "hast-util-from-html": "catalog:",
    "hast-util-to-html": "catalog:",
    "memfs": "^4.57.1",
    "pagefind": "^1.4.0",
    "tailwindcss": "^4.2.2",
    "typedoc": "^0.28.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.3.1",
    "vitest": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "^extract-docs"
        ]
      },
      "preview": {
        "dependsOn": [
          "^build",
          "^extract-docs"
        ]
      },
      "deploy": {
        "dependsOn": [
          "build"
        ],
        "executor": "nx-github-pages:deploy",
        "options": {
          "remote": "https://github.com/AgentEnder/isolated-workers.git",
          "directory": "{projectRoot}/dist/client"
        }
      }
    },
    "implicitDependencies": [
      "examples"
    ]
  },
  "type": "module"
}
